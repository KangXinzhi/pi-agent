{
	"name": "pi-agent-harness",
	"private": true,
	"type": "module",
	"version": "0.1.0",
	"workspaces": [
		"packages/*",
		"packages/session-backends/*"
	],
	"scripts": {
		"check": "biome check --write --error-on-warnings . && npm run check:pinned-deps && npm run check:tsc",
		"check:pinned-deps": "node scripts/check-pinned-deps.mjs",
		"check:tsc": "node scripts/check-tsc.mjs",
		"prepare": "husky",
		"test": "npm run test --workspaces --if-present"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"husky": "9.1.7",
		"tsx": "4.22.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
